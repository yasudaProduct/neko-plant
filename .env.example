# 環境変数のテンプレート。`cp .env.example .env.local` してから値を埋めてください。
# 各変数の説明は doc/02-development/setup.md を参照。

# --- App ---
NEXT_PUBLIC_APP_BASE_URL="http://localhost:3000"

# --- Database (Prisma) ---
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# --- Supabase ---
# ANON_KEY / SERVICE_ROLE_KEY は `supabase status` の出力をそのまま貼る
NEXT_PUBLIC_SUPABASE_URL="http://localhost:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth（ローカルでOAuthを試す場合のみ） ---
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- AI植物判定（任意）---
# 未設定でもAI判定が無効になるだけで投稿フローは動きます。
# AI_PROVIDER: "gemini"(既定) | "openai" | "mock"
AI_PROVIDER=gemini
GEMINI_API_KEY=
# OPENAI_API_KEY=                      # AI_PROVIDER=openai の場合に使用
# AI_PLANT_ID_MODEL=                   # 省略時はプロバイダーの既定モデル
# AI_IDENTIFY_RATE_LIMIT_PER_MINUTE=10 # 既定 10
# AI_IDENTIFY_RATE_LIMIT_PER_DAY=50    # 既定 50

# --- お知らせ機能 /news（任意）---
NOTION_API_KEY=
NOTION_DATABASE_ID=

# --- アナリティクス（任意）---
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# --- E2Eテスト ---
E2E_TEST_USER_ADDRESS="e2e@example.com"
E2E_TEST_USER_PASSWORD="password"
E2E_TEST_ADMIN_ADDRESS="admin@example.com"
E2E_TEST_ADMIN_PASSWORD="adminpass"
